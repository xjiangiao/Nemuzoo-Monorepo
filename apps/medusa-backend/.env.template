# Medusa Backend - Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=9000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# Redis (Upstash - get your URL from https://console.upstash.com)
# Format: redis://default:your-password@your-endpoint.upstash.io:6379
REDIS_URL=redis://default:your-password@your-endpoint.upstash.io:6379

# JWT & Cookie Secrets (generate random strings for production)
JWT_SECRET=supersecret-change-in-production
COOKIE_SECRET=supersecret-change-in-production

# CORS Origins
STORE_CORS=http://localhost:8000,https://www.nemuzoo.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://admin.nemuzoo.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://admin.nemuzoo.com

# Medusa Admin
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Cloudflare R2 (File Storage)
R2_FILE_URL=https://your-bucket.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=medusa-assets
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
