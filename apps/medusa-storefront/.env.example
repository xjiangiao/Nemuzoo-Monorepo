# Storefront Environment Variables
# Copy this file to .env.local and fill in your values

# Medusa Backend URL
# Production: https://api.nemuzoo.com
# Staging: https://api-staging.nemuzoo.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.nemuzoo.com

# Medusa Publishable API Key (create in admin dashboard → Settings → API Key Management)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY=pk_

# ImageKit URL endpoint
# Production should proxy https://static.nemuzoo.com
# Staging should proxy https://static-staging.nemuzoo.com
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Resend (for newsletter)
# Create an API key at https://resend.com/api-keys
# Create a topic at https://resend.com/audiences/topics
# Create segments at https://resend.com/audiences/segments
RESEND_API_KEY=re_
RESEND_TOPIC_ID=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_REGISTERED_USER_SEGMENT_ID=
MARKETING_EMAIL_FROM=marketing@nemuzoo.com

# Optional. Leave empty in production. Use comma-separated test emails in staging.
MARKETING_EMAIL_ALLOWLIST=
