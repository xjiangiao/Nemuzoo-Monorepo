# Production Environment Variables for VPS Deployment
# Copy this file to .env.production and fill in your values, then:
#   scp .env.production ubuntu@43.130.60.3:/opt/medusa/.env

# Server
NODE_ENV=production
PORT=9000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# Redis (Upstash)
REDIS_URL=redis://default:your-password@your-endpoint.upstash.io:6379

# JWT & Cookie Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your-generated-jwt-secret
COOKIE_SECRET=your-generated-cookie-secret

# CORS Origins
STORE_CORS=https://www.nemuzoo.com
ADMIN_CORS=https://admin.nemuzoo.com
AUTH_CORS=https://admin.nemuzoo.com

# Medusa Admin
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Cloudflare R2 (File Storage)
R2_FILE_URL=https://your-bucket.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=medusa-assets
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
