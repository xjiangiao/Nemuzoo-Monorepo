# Production backend environment
APP_ENV=production
NODE_ENV=production
PORT=9000

DATABASE_URL=postgres://user:password@host:5432/nemuzoo_prod
REDIS_URL=redis://host:6379

JWT_SECRET=replace-with-production-secret
COOKIE_SECRET=replace-with-production-secret

STORE_CORS=https://www.nemuzoo.com
ADMIN_CORS=https://admin.nemuzoo.com
AUTH_CORS=https://www.nemuzoo.com,https://admin.nemuzoo.com

MEDUSA_ADMIN_ONBOARDING_TYPE=default

R2_FILE_URL=https://static.nemuzoo.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=nemuzoo-prod
R2_ACCESS_KEY_ID=replace-with-production-r2-key
R2_SECRET_ACCESS_KEY=replace-with-production-r2-secret

# Fill these when the payment provider module is implemented.
# PAYMENT_PROVIDER=provider-id
# PAYMENT_ENV=production
# PAYMENT_API_KEY=replace-with-live-key
# PAYMENT_WEBHOOK_SECRET=replace-with-live-webhook-secret
