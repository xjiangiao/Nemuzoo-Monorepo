# Staging backend environment
APP_ENV=staging
NODE_ENV=production
PORT=9000

DATABASE_URL=postgres://user:password@host:5432/nemuzoo_staging
REDIS_URL=redis://host:6380

JWT_SECRET=replace-with-staging-secret
COOKIE_SECRET=replace-with-staging-secret

STORE_CORS=https://staging.nemuzoo.com
ADMIN_CORS=https://admin-staging.nemuzoo.com
AUTH_CORS=https://staging.nemuzoo.com,https://admin-staging.nemuzoo.com

MEDUSA_ADMIN_ONBOARDING_TYPE=default

R2_FILE_URL=https://static-staging.nemuzoo.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=nemuzoo-staging
R2_ACCESS_KEY_ID=replace-with-staging-r2-key
R2_SECRET_ACCESS_KEY=replace-with-staging-r2-secret

ORDER_EMAILS_ENABLED=true
RESEND_FROM_EMAIL=orders@nemuzoo.com
ACCOUNT_EMAILS_ENABLED=true
ACCOUNT_EMAIL_FROM=account@nemuzoo.com
RESEND_API_KEY=replace-with-staging-resend-key

# Fill these when the payment provider module is implemented.
# PAYMENT_PROVIDER=provider-id
# PAYMENT_ENV=sandbox
# PAYMENT_API_KEY=replace-with-sandbox-key
# PAYMENT_WEBHOOK_SECRET=replace-with-sandbox-webhook-secret
